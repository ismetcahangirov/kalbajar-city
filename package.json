{
  "name": "kalbajar-city",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint --max-warnings=0 && pnpm lint:tokens",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "budget:js": "node scripts/check-js-budget.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.mts",
    "db:seed": "tsx scripts/db-seed.mts",
    "db:studio": "drizzle-kit studio",
    "test:db": "vitest run --config vitest.db.config.mts",
    "auth:owner": "tsx scripts/auth-owner.mts",
    "storage:setup": "tsx scripts/storage-setup.mts",
    "leads:retention": "tsx scripts/leads-retention.mts",
    "defaults:encode": "tsx scripts/defaults-encode.mts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "^7.0.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-table": "^8.21.3",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lenis": "^1.3.27",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "nodemailer": "10.3.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-redux": "^9.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  }
}
