# Copy to .env and adjust. Every variable the application reads is listed here.

# Public origin of the site, used for canonical URLs, sitemaps and e-mail links.
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# "true" on staging: robots.txt disallows everything, and every public page
# sends `noindex, nofollow` (meta tag and X-Robots-Tag). Unset or "false" in
# production. Read at run time, so one image serves both.
SITE_NOINDEX=

# PostgreSQL (docker compose: postgres on 5442).
DATABASE_URL=postgres://kalbajar:kalbajar@localhost:5442/kalbajar
# Optional. `pnpm test:db` drops and recreates this database; it defaults to
# DATABASE_URL's database name with a `_test` suffix.
# TEST_DATABASE_URL=postgres://kalbajar:kalbajar@localhost:5442/kalbajar_test

# Better Auth. BETTER_AUTH_URL is the site origin; sign-in checks requests against
# it. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010

# S3-compatible object storage (docker compose: RustFS on 9010). Path-style
# URLs. S3_PUBLIC_URL is where the bucket's public `media/*` files are served
# from (the bucket URL, or a CDN in front of it). Prepare a bucket with
# `pnpm storage:setup`; it allows uploads from NEXT_PUBLIC_SITE_URL and
# BETTER_AUTH_URL.
S3_ENDPOINT=http://localhost:9010
S3_REGION=eu-central
S3_BUCKET=kalbajar
S3_ACCESS_KEY_ID=kalbajar
S3_SECRET_ACCESS_KEY=kalbajar-secret
S3_PUBLIC_URL=http://localhost:9010/kalbajar

# SMTP for password-reset e-mails, invitations and lead notifications (docker compose: Mailpit
# on 1035, UI on 8035).
SMTP_HOST=localhost
SMTP_PORT=1035
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Kalbajar City <no-reply@kalbajarcity.com>"

# Where lead notifications go: one address or several, comma-separated. When
# empty, leads go to the contacts e-mail in the console's settings.
LEADS_INBOX=

# Shared secret for internal endpoints a cron calls: every few minutes,
# `GET` or `POST /api/v1/internal/scheduled-publications` with
# `Authorization: Bearer $CRON_SECRET` publishes scheduled news and
# construction updates. The endpoint refuses every call while it is empty.
# Generate it with: openssl rand -base64 32
CRON_SECRET=

# The one request header that carries the client's IP, for the lead rate
# limit, the audit log and the sign-in rate limit. `cf-connecting-ip` in
# production and staging, which run behind Cloudflare: only that header is
# read, and a request without a valid IP in it counts as one shared unknown
# client, never as the spoofable first `X-Forwarded-For` entry. Safe only while
# Cloudflare is the only way to the origin (docs/runbooks/deploy.md §9).
# Leave empty in development and CI: the first `X-Forwarded-For` entry, then
# `X-Real-IP`, is used.
TRUSTED_CLIENT_IP_HEADER=
